# URL de l'API NestJS (utilisée par le proxy /api/backend)
BACKEND_URL=http://localhost:3000

# URL des WebSockets (notifications, commentaires, présence)
NEXT_PUBLIC_BACKEND_WS_URL=http://localhost:3000

# Délai max d'une requête proxifiée, en ms (25 min : les générations LLM sont longues)
PROXY_TIMEOUT_MS=1500000

# Optionnel : email pour relever le quota gratuit de l'API de traduction MyMemory
NEXT_PUBLIC_MYMEMORY_EMAIL=
