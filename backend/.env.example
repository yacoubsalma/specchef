# ── Base de données (MongoDB Atlas) ──────────────────────────────────────────
DATABASE_URL=

# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:3004

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ── Langfuse (traces) ────────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# ── JWT (obligatoire) ────────────────────────────────────────────────────────
JWT_SECRET=

# ── Email pour les codes OTP ─────────────────────────────────────────────────
# Si non renseigné, les emails sont affichés dans la console du serveur.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# ── Compte Admin initial (utilisé une seule fois par le seed) ────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ── Azure Translator (traduction FR→EN avant chaque prompt LLM) ──────────────
# Optionnel : sans clé, le texte est transmis tel quel.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=

# ── Jira ─────────────────────────────────────────────────────────────────────
JIRA_TOKEN_ENCRYPTION_KEY=

# ── Optionnel ────────────────────────────────────────────────────────────────
TOKENIZER_PATH=
