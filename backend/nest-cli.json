{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "deleteOutDir": true,
        "assets": [
            { "include": "templates/**/*", "outDir": "dist" },
            { "include": "src/assets/**/*", "outDir": "dist" }
        ],
        "watchAssets": true
    }
}
